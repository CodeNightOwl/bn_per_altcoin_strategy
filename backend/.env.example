# 服务器配置
FLASK_HOST=0.0.0.0
FLASK_PORT=3007
FLASK_DEBUG=True

# 数据库配置 (sqlite 或 mysql)
DB_TYPE=sqlite

# SQLite配置 (当DB_TYPE=sqlite时使用)
SQLITE_DB_PATH=crypto_monitor.db

# MySQL配置 (当DB_TYPE=mysql时使用)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=crypto_monitor
MYSQL_CHARSET=utf8mb4

# 币安API配置 (可选，用于获取更多数据)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENABLE_RATE_LIMIT=True

# 数据过滤配置
MIN_VOLUME_USD=1000000
MAX_COINS_LIMIT=500
EXCLUDE_STABLECOINS=True

# 主流币种列表 (这些币种将被过滤掉，不显示在山寨币列表中)
MAJOR_COINS=BTC,ETH,BNB,USDT,USDC,BUSD,DAI,XRP,ADA,DOGE,SOL,DOT,MATIC,SHIB,LTC,TRX,AVAX,LINK,ATOM,UNI

# 更新间隔配置
COIN_UPDATE_INTERVAL=60
AUTO_UPDATE_ENABLED=False

# CORS配置
CORS_ENABLED=True
CORS_ORIGINS=*

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 分页配置
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200